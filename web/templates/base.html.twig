{# Gabarit commun à toutes les pages : en-tête, messages flash, contenu. #}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Ordonnancement{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📅</text></svg>">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="entete">
            <a href="{{ path('projet_liste') }}" class="logo">📅 Ordonnancement</a>
            <nav>
                <a href="{{ path('projet_liste') }}">Projets</a>
                <a href="{{ path('projet_nouveau') }}" class="bouton">+ Nouveau projet</a>
            </nav>
        </header>

        <main class="contenu">
            {# Messages de confirmation (ajoutés par addFlash() dans les contrôleurs) #}
            {% for message in app.flashes('succes') %}
                <div class="flash flash-succes">{{ message }}</div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
