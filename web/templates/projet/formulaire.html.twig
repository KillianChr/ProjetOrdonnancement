{# Formulaire de création / modification d'un projet. #}
{% extends 'base.html.twig' %}

{% block title %}{{ titre }} — Ordonnancement{% endblock %}

{% block body %}
    <section class="entete-formulaire">
        <p class="fil"><a href="{{ path('projet_liste') }}">Projets</a><span>/</span><span class="fil-actuel">{{ titre }}</span></p>
        <h1 class="titre-grand">{{ titre }}</h1>
    </section>

    {{ form_start(form, {attr: {class: 'feuille formulaire'}}) }}
        {{ form_widget(form) }}
        <div class="actions">
            <button type="submit" class="bouton bouton-grand">Enregistrer le projet</button>
            <a href="{{ path('projet_liste') }}" class="bouton-discret">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
